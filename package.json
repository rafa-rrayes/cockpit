{
  "name": "cockpit",
  "displayName": "Cockpit",
  "description": "A live overview of the project and every Claude Code session, in place of the editor.",
  "version": "0.1.0",
  "publisher": "rrayes",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:cockpit.overview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cockpit.open",
        "title": "Open",
        "category": "Cockpit",
        "icon": "$(dashboard)"
      },
      {
        "command": "cockpit.refresh",
        "title": "Refresh",
        "category": "Cockpit",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cockpit",
          "title": "Cockpit",
          "icon": "media/cockpit.svg"
        }
      ]
    },
    "views": {
      "cockpit": [
        {
          "id": "cockpit.home",
          "name": "Overview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cockpit.home",
        "contents": "Cockpit shows every Claude Code session on this machine, with the worktrees, pull requests, CI and releases of this project, in the editor area.\n[Open Cockpit](command:cockpit.open)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cockpit.refresh",
          "when": "view == cockpit.home",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cockpit",
      "properties": {
        "cockpit.openOnStartup": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open Cockpit as the first, pinned tab when a window starts. Files you had open stay open beside it. Pair it with `#workbench.startupEditor#`: `none` so the Welcome page does not open too."
        },
        "cockpit.endedSessionDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "maximum": 90,
          "description": "How many days of ended Claude sessions to show."
        },
        "cockpit.githubPollSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "How often to ask GitHub (through gh) for pull requests and CI runs while Cockpit is visible. Nothing is asked while it is hidden."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "vitest run",
    "smoke": "npm run build && node test/smoke/run.mjs",
    "dump-state": "node dist/dump-state.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "preact": "^11.2.0",
    "typescript": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
